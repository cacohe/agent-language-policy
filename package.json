{
  "name": "agent-language-policy",
  "version": "0.1.0",
  "description": "Keep human decision content in a chosen language while preserving technical literals.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "cacohe and contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacohe/agent-language-policy.git"
  },
  "homepage": "https://github.com/cacohe/agent-language-policy#readme",
  "bugs": {
    "url": "https://github.com/cacohe/agent-language-policy/issues"
  },
  "keywords": [
    "agent-skills",
    "coding-agents",
    "internationalization",
    "language-policy",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "verify": "node scripts/verify.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release": "npm run verify && npm run verify:package",
    "prepack": "npm run verify -- --skip-tests"
  },
  "bin": {
    "agent-language-policy": "./bin/agent-language-policy.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "policy/",
    "plugin.json",
    ".codex-plugin/",
    ".claude-plugin/",
    "gemini-extension.json",
    "README.md",
    "README.zh-CN.md",
    "README.zh-TW.md",
    "README.ko-KR.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/architecture.md",
    "LICENSE",
    "NOTICE"
  ]
}
